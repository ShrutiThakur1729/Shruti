# Frontend (injected at build time; exposes the backend base URL to the client bundle)
REACT_APP_BACKEND_URL=https://your-backend.example.com

# Backend
MONGO_URL="mongodb://localhost:27017"
DB_NAME="the_world_inside"
CORS_ORIGINS="*"

# Server-side only. Never expose in the browser bundle.
EMERGENT_LLM_KEY=""
GITHUB_TOKEN=""

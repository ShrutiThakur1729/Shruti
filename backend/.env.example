# Backend environment — copy to .env and fill in. Never commit the real .env.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="the_world_inside"
CORS_ORIGINS="*"
# Confidential. Enables the AI narrator (POST /api/narrate). Without it the app falls back to text-only captions.
EMERGENT_LLM_KEY=""
# Confidential. Owner/tooling only; the app itself never reads it.
GITHUB_TOKEN=""
